# Hosted PostgreSQL connection string
# Neon:    postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Supabase: postgresql://postgres:pass@db.xxxx.supabase.co:5432/postgres
# TiDB:    mysql://user:pass@gateway01.xxx.prod.aws.tidbcloud.com:4000/test?sslaccept=strict
#          (also change prisma/schema.prisma provider to "mysql")
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
